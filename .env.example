# 只放变量名称和示例值，绝不能填写真实密钥
API_KEY=replace_with_your_dashscope_api_key
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-vl-max
# 百炼图像编辑接口需要包含工作空间ID，例如：
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
IMAGE_MODEL_NAME=qwen-image-edit-max
# Comma-separated HTTPS host suffixes allowed for provider result downloads.
STYLE_IMAGE_SOURCE_HOSTS=aliyuncs.com
AUTH_TOKEN_SECRET=replace_with_at_least_32_random_characters

# Supabase服务端配置；SUPABASE_SECRET_KEY绝不能放进public目录
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_supabase_secret_key
