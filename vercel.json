{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/start-analysis.js": {
      "maxDuration": 60
    },
    "api/analysis-worker.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "analysis-jobs",
          "retryAfterSeconds": 120,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/style-image-worker.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "style-image-jobs",
          "retryAfterSeconds": 300,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
